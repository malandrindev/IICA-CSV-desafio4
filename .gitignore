# Python
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Ambientes e segredos
.venv/
venv/
.env
.env.*
!.env.example
.streamlit/secrets.toml

# IDE e sistema
.idea/
.vscode/
.DS_Store
Thumbs.db

# Dados locais e saídas geradas
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/samples/*
!data/samples/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
outputs/entrega/*
!outputs/entrega/.gitkeep

# Rascunhos descartáveis podem ficar em scratch; demais trabalhos são versionáveis
workspaces/**/scratch/

# Arquivos grandes e temporários
*.zip
*.tmp
*.log
~$*
